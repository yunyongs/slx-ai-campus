# Only notes and source go to GitHub.
# 1) ignore everything, 2) allow notes and source back in,
# 3) re-ignore generated or private files that sit inside those places.
# Gradle files (build.gradle, settings.gradle, gradlew, gradle/, .gradle/, build/)
# are never allowed back in, so they always stay local.

### 1. Ignore everything (folders stay open so git can look inside) ###
*
!*/

### 2. Allow notes and source ###
!/.gitignore
!/README.md
!/*/README.md
!/00_Note/**
!**/src/**
!*.sql
!*.http

### 3. Re-ignore generated or private files ###
# Tool and build folders: git does not even look inside these
.gradle/
gradle/
build/
.mvn/
target/
out/
bin/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/bin/
!**/src/test/**/bin/
.idea/
.vscode/
.kotlin/
node_modules/
.venv/

# Generated files inside src
*ApplicationTests.java
*.class

# Images, including note screenshots in 00_Note/image/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.svg
*.ico
*.heic

# OS files
.DS_Store
desktop.ini
Thumbs.db

# Secrets
.env
.env-docker

# Local-only folders and files
.omc/
.mcp.json
CLAUDE.md
.claude/
agent.md
postman/
.postman/
01_Java/practice/
apache-tomcat-11.0.27/
demo/
